<Application x:Class="FigureDrawer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:FigureDrawer"
             xmlns:vm="clr-namespace:FigureDrawer.SettingsViewModels"
             xmlns:settingsViews="clr-namespace:FigureDrawer.SettingsViews"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Стили -->
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Brown" SecondaryColor="LightBlue" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                <ResourceDictionary Source="/Resources/ResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- DataTemplate -->
            <DataTemplate DataType="{x:Type vm:CircleSettings}">
                <settingsViews:CircleSettingsView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:RectangleSettings}">
                <settingsViews:RectangleSettingsView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:TriangleSettings}">
                <settingsViews:TriangleSettingsView/>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
